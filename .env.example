# GEMINI_API_KEY: Required for Gemini AI Agricultural Advisory calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# BRIGHTDATA_API_KEY: Bright Data API Token for Scraper Studio DCA API
BRIGHTDATA_API_KEY=YOUR_BRIGHTDATA_API_KEY

# BRIGHTDATA_COLLECTOR_ID: Persistent Collector ID for Regional APMC Spices Scraper
BRIGHTDATA_COLLECTOR_ID=c_apmc_spice_v1_09x

# BACKEND_PROXY_URL: Free tier backend proxy (Render/Vercel/Cloudflare)
BACKEND_PROXY_URL=https://your-agrisync-backend.onrender.com

